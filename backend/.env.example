# ─── Server Configuration ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Connection string for your MongoDB instance (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/smart_meter

# ─── Security & Authentication ─────────────────────────────────────────────────
# Generate a strong random secret using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_signing_secret_string
JWT_EXPIRES_IN=7d

# Secret for validating incoming telemetry from ESP32 devices
DEVICE_SECRET=SmartHostelDeviceSecret123

# ─── Gemini AI Configuration ───────────────────────────────────────────────────
# Get an API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Threshold in Watts above which the anomaly detector analyses the load
ANOMALY_POWER_THRESHOLD=1000

# ─── SSLCommerz Payment Gateway ───────────────────────────────────────────────
# Register at: https://developer.sslcommerz.com/registration/
# For testing, use Sandbox credentials and set SSL_IS_LIVE=false
SSL_STORE_ID=your_store_id
SSL_STORE_PASSWORD=your_store_password
SSL_IS_LIVE=false

# ─── Carbon Footprint ─────────────────────────────────────────────────────────
# Bangladesh grid emission factor: kg CO₂ emitted per kWh consumed
CARBON_EMISSION_FACTOR=0.67
